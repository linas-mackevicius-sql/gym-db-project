<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  
  <PropertyGroup>
    <Name>gym_db_project</Name>
    <ProjectGuid>{4265AE6E-F876-4BF9-BCE0-DFA0A31550A5}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include all SQL files -->
    <Build Include="dbo\tables\**\*.sql" />
    <Build Include="dbo\views\**\*.sql" />
    <Build Include="dbo\Schemas\**\*.sql" />
    <Build Remove="dbo\data\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="dbo\data" />
  </ItemGroup>

  <ItemGroup>
    <PostDeploy Include="dbo\data\data_insertion.sql" />
  </ItemGroup>

</Project>